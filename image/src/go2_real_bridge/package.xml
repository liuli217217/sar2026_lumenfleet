<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>go2_real_bridge</name>
  <version>0.1.0</version>
  <description>Runs the four SAR algorithm packages (go2_sar_slam / _prior / _reflex / _scout) on the real Unitree Go2: sport API, L1 lidar, D435i camera, plus a fake Go2 to test the same stack in Gazebo</description>
  <maintainer email="liuli217217@gmail.com">ll</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>go2_sar_core</exec_depend>
  <exec_depend>go2_sar_scout</exec_depend>
  <exec_depend>go2_sar_reflex</exec_depend>
  <exec_depend>go2_sar_prior</exec_depend>
  <exec_depend>go2_sar_slam</exec_depend>
  <exec_depend>unitree_go</exec_depend>
  <exec_depend>unitree_api</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
