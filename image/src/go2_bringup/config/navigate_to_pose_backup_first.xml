<!--
  Nav2's stock navigate_to_pose_w_replanning_and_recovery.xml (Jazzy), with
  one change: BackUp is promoted ahead of Spin and Wait in the RecoveryActions
  RoundRobin (2026-11-09).

  Stock order was ClearingActions -> Spin -> Wait -> BackUp. RoundRobin
  advances to the next child on each successive recovery trigger, so Spin
  (needs clearance on every side) was always tried before BackUp (only needs
  clearance behind the robot), backwards for a robot stuck in a space tight
  enough that no heading clears an in-place rotation, but straight-line
  retreat is still possible. Confirmed via live testing: the robot can latch
  in collision_debounce's STOP state for 9+ seconds in exactly this kind of
  spot, and Spin's own prior failure ("Exceeded time allowance before
  reaching the Spin goal") wastes a cycle before BackUp is ever attempted.

  No other change from the stock file, same RecoveryNode retry budget (6),
  same ComputePathToPose/FollowPath recovery subtrees, same costmap-clearing
  Sequence.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath" topic_name="controller_selector"/>
        <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector"/>
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}"/>
            <Sequence>
              <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="{selected_controller}" error_code_id="{follow_path_error_code}"/>
          <Sequence>
            <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
            <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <Sequence>
        <Fallback>
          <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
          <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
        </Fallback>
        <ReactiveFallback name="RecoveryFallback">
          <GoalUpdated/>
          <RoundRobin name="RecoveryActions">
            <Sequence name="ClearingActions">
              <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
            <!-- backup_speed raised 0.15->0.50 (2026-11-11): 0.15 m/s sits
                 below collision_debounce's 0.4 m/s linear deadband, so this
                 BT-internal recovery action was silently commanding zero
                 regardless of how often it fired. Confirmed via Codex
                 review of this file alongside the diagnostic handoff at
                 docs/DIAGNOSTIC_STUCK_NEAR_OBSTACLES_NO_RECOVERY_2026-11-11.md. -->
            <BackUp backup_dist="0.30" backup_speed="0.50" error_code_id="{backup_code_id}"/>
            <Spin spin_dist="1.57" error_code_id="{spin_error_code}"/>
            <Wait wait_duration="5.0"/>
          </RoundRobin>
        </ReactiveFallback>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
